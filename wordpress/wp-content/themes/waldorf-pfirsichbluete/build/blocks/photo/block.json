{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "waldorf/photo",
  "version": "1.0.0",
  "title": "Foto",
  "category": "waldorf",
  "icon": "format-image",
  "description": "Ein Foto in einer organischen Waldorf-Form.",
  "keywords": [
    "Bild",
    "Foto",
    "Waldorf"
  ],
  "textdomain": "waldorf-pfirsichbluete",
  "attributes": {
    "id": {
      "type": "integer",
      "default": 0
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "shape": {
      "type": "string",
      "enum": [
        "hero",
        "mosaic1",
        "mosaic2",
        "mosaic3",
        "mosaic4",
        "group",
        "rhythm",
        "food",
        "person",
        "round"
      ],
      "default": "hero"
    },
    "focalPoint": {
      "type": "object",
      "default": {
        "x": 0.5,
        "y": 0.5
      }
    },
    "alt": {
      "type": "string",
      "default": ""
    },
    "fallback": {
      "type": "string",
      "default": "photo-hero.jpg"
    }
  },
  "supports": {
    "html": false
  },
  "usesContext": [
    "waldorf/isMosaic"
  ],
  "example": {
    "attributes": {
      "caption": "Beispielbild · Freispiel im Garten"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}