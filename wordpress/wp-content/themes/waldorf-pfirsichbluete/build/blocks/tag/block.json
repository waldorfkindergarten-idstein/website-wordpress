{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "waldorf/tag",
  "version": "1.0.0",
  "title": "Wochentag",
  "category": "waldorf",
  "icon": "calendar-alt",
  "description": "Ein wiederkehrendes Angebot im Wochenrhythmus.",
  "keywords": [
    "Tag",
    "Woche",
    "Waldtag"
  ],
  "textdomain": "waldorf-pfirsichbluete",
  "attributes": {
    "weekday": {
      "type": "string",
      "default": "Montag"
    },
    "title": {
      "type": "string",
      "default": "Malen"
    },
    "text": {
      "type": "string",
      "default": "Mit Aquarellfarben auf großem Papier."
    },
    "isForestDay": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}