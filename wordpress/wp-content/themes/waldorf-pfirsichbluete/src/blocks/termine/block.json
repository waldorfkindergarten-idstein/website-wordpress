{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waldorf/termine",
	"version": "1.0.0",
	"title": "Terminliste",
	"category": "waldorf",
	"icon": "calendar-alt",
	"description": "Die nächsten Termine aus dem Bereich „Termine“ im Backend.",
	"textdomain": "waldorf-pfirsichbluete",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Termine"
		},
		"count": {
			"type": "integer",
			"default": 4
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
