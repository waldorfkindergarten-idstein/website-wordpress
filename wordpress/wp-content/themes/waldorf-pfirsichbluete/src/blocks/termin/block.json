{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waldorf/termin",
	"version": "1.0.0",
	"title": "Termin",
	"category": "waldorf",
	"icon": "calendar-alt",
	"description": "Ein Termin mit Datum, Titel und Zusatzinformation.",
	"textdomain": "waldorf-pfirsichbluete",
	"parent": [ "waldorf/termine" ],
	"attributes": {
		"date": {
			"type": "string",
			"default": "2026-10-06"
		},
		"title": {
			"type": "string",
			"default": "Termin"
		},
		"detail": {
			"type": "string",
			"default": "Uhrzeit und Hinweise"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
