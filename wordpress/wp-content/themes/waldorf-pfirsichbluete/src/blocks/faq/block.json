{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waldorf/faq",
	"version": "1.0.0",
	"title": "Häufige Frage",
	"category": "waldorf",
	"icon": "editor-help",
	"description": "Eine aufklappbare Frage mit Antwort.",
	"textdomain": "waldorf-pfirsichbluete",
	"parent": [ "waldorf/faqs" ],
	"attributes": {
		"question": {
			"type": "string",
			"default": "Ihre Frage"
		},
		"answer": {
			"type": "string",
			"default": "Die passende Antwort."
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
