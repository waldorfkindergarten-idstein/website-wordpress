{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waldorf/person",
	"version": "1.0.0",
	"title": "Teammitglied",
	"category": "waldorf",
	"icon": "admin-users",
	"description": "Ein Teammitglied mit Foto oder Monogramm.",
	"keywords": [ "Person", "Team", "Mitarbeiter" ],
	"textdomain": "waldorf-pfirsichbluete",
	"attributes": {
		"id": {
			"type": "integer",
			"default": 0
		},
		"fallback": {
			"type": "string",
			"default": ""
		},
		"focalPoint": {
			"type": "object",
			"default": {
				"x": 0.5,
				"y": 0.5
			}
		},
		"alt": {
			"type": "string",
			"default": ""
		},
		"monogram": {
			"type": "string",
			"default": "L"
		},
		"name": {
			"type": "string",
			"default": "Leitung"
		},
		"role": {
			"type": "string",
			"default": "Pädagogische Gesamtleitung"
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
